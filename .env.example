# O programa nunca gera narração. Importe a voz feita no Dark Planner.
GEMINI_API_KEY=
COAE_WRITER_MODEL=
COAE_AUDITOR_MODEL=
COAE_IMAGE_MODEL=
# 0 desabilita chamadas. O teto é por projeto, inclui falhas e não é limite monetário.
COAE_MAX_CALLS_PER_PROJECT=0
# Primeiro uso baixa este modelo; também aceita caminho de um modelo local.
COAE_WHISPER_MODEL=small

# Para modo local, troque os dois providers por ollama / comfyui.
# O padrão gemini preserva instalações existentes; não há fallback automático.
COAE_TEXT_PROVIDER=gemini
COAE_IMAGE_PROVIDER=gemini
COAE_OLLAMA_URL=http://127.0.0.1:11434
COAE_LOCAL_WRITER_MODEL=
# Vazio reutiliza escritor para texto; visão exige modelo separado configurado.
COAE_LOCAL_AUDITOR_MODEL=
COAE_LOCAL_VISION_MODEL=
COAE_COMFYUI_URL=http://127.0.0.1:8188
COAE_COMFYUI_WORKFLOW=workflows/sdxl_api.example.json
COAE_COMFYUI_PROMPT_NODE=6
COAE_COMFYUI_OUTPUT_NODE=9
COAE_LOCAL_TIMEOUT=600
